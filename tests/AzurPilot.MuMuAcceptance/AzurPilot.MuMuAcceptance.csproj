<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тестовый инструмент приёмки MuMu на реальной установке Windows. Это не тестовый проект
       (тестовой платформы и xunit здесь нет) и не boundary приложения: он подключает production
       IMuMuHost из AzurPilot.Windows и orchestration MuMuLifecycleService из AzurPilot.Core, но
       ничего не добавляет в AzurPilot.App и не зависит от него. Продуктовый CLI, REPL и doctor-команда
       по-прежнему отсутствуют: аргументы разбирает только этот инструмент.
       Направление зависимостей: AzurPilot.MuMuAcceptance → AzurPilot.Windows → AzurPilot.Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AzurPilot.MuMuAcceptance</RootNamespace>
    <AssemblyName>AzurPilot.MuMuAcceptance</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <!-- Производственные контракты и платформенная реализация MuMu. Ссылок на AzurPilot.App нет:
         приёмка не является частью приложения и не переиспользует его composition root. -->
    <ProjectReference Include="..\..\src\AzurPilot.Core\AzurPilot.Core.csproj" />
    <ProjectReference Include="..\..\src\AzurPilot.Windows\AzurPilot.Windows.csproj" />
  </ItemGroup>

</Project>
