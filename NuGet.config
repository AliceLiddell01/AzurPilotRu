<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Минимально достаточная конфигурация: единственный публичный источник пакетов.
       Версии пакетов здесь не задаются — владелец Directory.Packages.props. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
