<Project>

  <!-- Централизованный владелец версий NuGet-пакетов. Версии задаются только здесь; проекты
       ссылаются на пакеты без Version. Перечислены исключительно реальные потребители. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Только Harness для разработки: управление Chromium и PNG настоящего терминального рендерера. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" />
    <!-- Строгая конфигурация приложения типизирует минимальный уровень логирования стандартным
         Microsoft.Extensions.Logging.LogLevel, а не собственной копией списка значений. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Application host приложения: стандартный generic host (Host.CreateEmptyApplicationBuilder),
         на котором стоит composition root AzurPilot.App. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Windows terminal operator surface; только AzurPilot.App владеет интерактивным UI. -->
    <PackageVersion Include="Terminal.Gui" Version="2.5.0" />
    <!-- Человекочитаемый YAML-формат пользовательской конфигурации: строгий разбор документа
         принадлежит AzurPilot.Core, потому что владельцем схемы остаётся Core. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Rich-like отрисовка отдельной лог-консоли: цвета, уровни и подсветка значений. Пакет
         используется только процессом viewer-а, а не интерактивным Terminal.Gui экраном. -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестовый стек: xunit.v3 (Microsoft.Testing.Platform) + адаптер и SDK тестовой платформы. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>

</Project>
