# Закреплённые device-side зависимости транспортов снимков: manifest, HTTPS, SHA256, staging.
# Runtime повторно проверяет SHA256 по тому же manifest перед отправкой файла на устройство.
set(AZURPILOT_CAPTURE_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/../capture-dependencies.json")
file(READ "${AZURPILOT_CAPTURE_MANIFEST}" capture_json)
string(JSON capture_count ERROR_VARIABLE json_error LENGTH "${capture_json}" dependencies)
if(json_error OR capture_count LESS 1)
  message(FATAL_ERROR "native/capture-dependencies.json: некорректный список dependencies: ${json_error}")
endif()

get_filename_component(capture_repository_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(capture_download_dir "${capture_repository_root}/artifacts/downloads/capture")
set(AZURPILOT_CAPTURE_STAGE_DIR "${capture_repository_root}/artifacts/native/capture")
file(MAKE_DIRECTORY "${capture_download_dir}" "${AZURPILOT_CAPTURE_STAGE_DIR}")
file(LOCK "${capture_download_dir}/capture.lock" GUARD FILE TIMEOUT 300)

math(EXPR capture_last "${capture_count} - 1")
foreach(index RANGE ${capture_last})
  foreach(field IN ITEMS id file url sha256 license)
    string(JSON value ERROR_VARIABLE json_error GET "${capture_json}" dependencies ${index} "${field}")
    if(json_error OR value STREQUAL "")
      message(FATAL_ERROR "native/capture-dependencies.json: у зависимости ${index} нет поля ${field}: ${json_error}")
    endif()
    set("dep_${field}" "${value}")
  endforeach()
  if(NOT dep_url MATCHES "^https://")
    message(FATAL_ERROR "native/capture-dependencies.json: ${dep_id} должен скачиваться по HTTPS.")
  endif()
  if(NOT dep_file MATCHES "^[A-Za-z0-9._-]+$")
    message(FATAL_ERROR "native/capture-dependencies.json: имя файла ${dep_file} должно быть простым именем.")
  endif()
  string(LENGTH "${dep_sha256}" hash_length)
  if(NOT hash_length EQUAL 64 OR NOT dep_sha256 MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "native/capture-dependencies.json: sha256 ${dep_id} должен содержать 64 шестнадцатеричных символа.")
  endif()
  string(TOLOWER "${dep_sha256}" expected_hash)
  set(cached "${capture_download_dir}/${dep_file}")
  if(NOT EXISTS "${cached}")
    message(STATUS "Получение зависимости захвата ${dep_id}: ${dep_url}")
    file(DOWNLOAD "${dep_url}" "${cached}.partial" TLS_VERIFY ON STATUS download_status INACTIVITY_TIMEOUT 120)
    list(GET download_status 0 download_code)
    if(NOT download_code EQUAL 0)
      file(REMOVE "${cached}.partial")
      message(FATAL_ERROR "Не удалось скачать ${dep_id}: ${download_status}")
    endif()
    file(RENAME "${cached}.partial" "${cached}")
  endif()
  # Новая и кэшированная копии проходят одну проверку; файл с другим hash не staging-уется.
  file(SHA256 "${cached}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    file(REMOVE "${cached}")
    message(FATAL_ERROR "SHA256 ${dep_id} не совпал: ожидалось ${expected_hash}; получено ${actual_hash}.")
  endif()
  file(COPY_FILE "${cached}" "${AZURPILOT_CAPTURE_STAGE_DIR}/${dep_file}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${AZURPILOT_CAPTURE_MANIFEST}" "${AZURPILOT_CAPTURE_STAGE_DIR}/capture-dependencies.json" ONLY_IF_DIFFERENT)
message(STATUS "Зависимости захвата: ${capture_count} файлов, SHA256 проверен; staging=${AZURPILOT_CAPTURE_STAGE_DIR}")
