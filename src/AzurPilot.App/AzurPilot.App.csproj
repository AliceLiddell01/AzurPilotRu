<Project Sdk="Microsoft.NET.Sdk">

  <!-- Composition root: единственная точка входа managed приложения и единственное место, где
       собирается application host (Host.CreateEmptyApplicationBuilder). Пакетов командной строки
       здесь нет: интерактивный REPL и продуктовый CLI — будущая capability. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AzurPilot.App</RootNamespace>
    <AssemblyName>AzurPilot.App</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzurPilot.Windows\AzurPilot.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Версия пакета — владелец Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
