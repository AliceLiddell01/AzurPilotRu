<Project Sdk="Microsoft.NET.Sdk">

  <!-- Composition root: единственная точка входа managed приложения и единственное место, где
       собирается application host (Host.CreateEmptyApplicationBuilder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AzurPilot.App</RootNamespace>
    <AssemblyName>AzurPilot.App</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzurPilot.Windows\AzurPilot.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzurPilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Версия пакета — владелец Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Terminal.Gui" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

</Project>
