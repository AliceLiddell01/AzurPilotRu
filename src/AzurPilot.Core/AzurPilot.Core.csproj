<Project Sdk="Microsoft.NET.Sdk">

  <!-- Доменный/application-контракт, независимый от Windows: знает о форме native boundary, но не
       о Windows API и не о способе загрузки native библиотеки. Общие свойства — Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>AzurPilot.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzurPilot.Tests" />
    <!-- Тип LogLevel принадлежит стандартному logging stack,
         поэтому уровень логирования типизирован им, а не второй копией списка допустимых значений.
         Пакет кроссплатформенный и не даёт Core знания о Windows API. Версия — владелец
         Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Строгий разбор человекочитаемого YAML-документа конфигурации. Схема, допустимые значения и
         семантика остаются в Core: пакет даёт только синтаксис YAML, а не второй владелец правил. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
