<Project>

  <!-- Directory.Build.props задаёт TreatWarningsAsErrors=true безусловно, а этот файл исполняется
       после NuGet-generated кода и выключает строгость там, где проект объявил
       AzurPilotStrictProject=false. Такой проект собирается без падения на предупреждениях
       сторонних NuGet/analyzer/targets, при этом все остальные свойства наследуются как есть. -->
  <PropertyGroup Condition="'$(AzurPilotStrictProject)' == 'false'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- CMake готовит runtime по соглашению относительно репозитория. MSBuild получает его
       автоматически; Content передаётся также проектам-потребителям Windows boundary. -->
  <PropertyGroup>
    <_AzurPilotRuntimeDirectory>$(MSBuildThisFileDirectory)artifacts/native/runtime/$(Configuration)</_AzurPilotRuntimeDirectory>
    <_AzurPilotAbiMismatchFixture>$(MSBuildThisFileDirectory)artifacts/native/abi-mismatch/$(Configuration)/AzurPilot.Native.dll</_AzurPilotAbiMismatchFixture>
  </PropertyGroup>

  <Target Name="AzurPilotIncludeNativeRuntime"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(MSBuildProjectName)' == 'AzurPilot.Windows' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(_AzurPilotRuntimeDirectory)/AzurPilot.Native.dll')"
           Text="Не найден native runtime: $(_AzurPilotRuntimeDirectory)/AzurPilot.Native.dll. Сначала из каталога native выполните CMake workflow preset native-x64-release (для Release) или native-x64-debug (для Debug)." />
    <ItemGroup>
      <_AzurPilotOpenCvRuntime Include="$(_AzurPilotRuntimeDirectory)/opencv_world*.dll" />
    </ItemGroup>
    <Error Condition="'@(_AzurPilotOpenCvRuntime)' == ''"
           Text="Не найдена runtime DLL OpenCV в $(_AzurPilotRuntimeDirectory). Соберите соответствующий CMake workflow preset native-x64-release или native-x64-debug из каталога native." />
    <ItemGroup>
      <Content Include="$(_AzurPilotRuntimeDirectory)/*.dll;$(_AzurPilotRuntimeDirectory)/*.pdb"
               Link="%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Visible="false" />
    </ItemGroup>
  </Target>

  <!-- ABI fixture остаётся в отдельном каталоге теста и не подменяет production DLL. -->
  <Target Name="AzurPilotIncludeAbiMismatchFixture"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(MSBuildProjectName)' == 'AzurPilot.Tests' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(_AzurPilotAbiMismatchFixture)')"
           Text="Не найдена негативная ABI fixture: $(_AzurPilotAbiMismatchFixture). Сначала соберите соответствующий CMake workflow preset native-x64-release или native-x64-debug из каталога native." />
    <ItemGroup>
      <Content Include="$(_AzurPilotAbiMismatchFixture)"
               Link="abi-mismatch/AzurPilot.Native.dll"
               CopyToOutputDirectory="PreserveNewest"
               Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Копирование пробы негативной проверки interop boundary в выход тестового проекта: тест
       запускает пробу процессом из каталога, где native библиотеки заведомо нет, поэтому проба
       должна быть отдельной сборкой рядом с тестом, а не ссылкой на код. -->
  <Target Name="AzurPilotStageNativeAbsenceProbe"
          AfterTargets="Build"
          Condition="'$(AzurPilotNativeAbsenceProbeProject)' != ''">
    <MSBuild Projects="$(AzurPilotNativeAbsenceProbeProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AzurPilotProbeAssembly" />
    </MSBuild>

    <ItemGroup>
      <_AzurPilotProbeFile Include="@(_AzurPilotProbeAssembly)" />
      <_AzurPilotProbeFile Include="@(_AzurPilotProbeAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <_AzurPilotProbeFile Include="@(_AzurPilotProbeAssembly->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>

    <Copy SourceFiles="@(_AzurPilotProbeFile)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
