# Windows / файловая система
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
*:Zone.Identifier

# macOS metadata — не должен попадать в публичный репозиторий от внешних contributors
.DS_Store

# Visual Studio / JetBrains user state
.vs/
.idea/
*.suo
*.user
*.userosscache
*.rsuser
*.sln.docstates
*.DotSettings.user

# Локальные переменные окружения и секреты
.env
.env.*
!.env.example
!.env.*.example

# Временные файлы и резервные копии редакторов
*.tmp
*.temp
*.bak
*.swp
*~

# Локальное рабочее состояние Codex; не является контрактом репозитория
/.codex/local/

# Локальное рабочее состояние agent team (DSH AgentTeams): описания задач, отчёты и
# машинно-зависимые пути. Не является контрактом репозитория и не публикуется.
/.agent-teams/

# Единственная ignored boundary для generated/build outputs и полученных native
# dependencies (включая native build directories и распакованный OpenCV).
/artifacts/

# Локальные пользовательские настройки CMake не являются частью контракта репозитория:
# per-machine overrides живут в CMakeUserPresets.json и не коммитятся.
CMakeUserPresets.json

# Managed build outputs: bin/ и obj/ проектов — generated, в Git не коммитятся.
# Lock-файлы (packages.lock.json) остаются отслеживаемыми: они часть контракта
# воспроизводимого restore (RestorePackagesWithLockFile в Directory.Build.props).
bin/
obj/

# Локальные артефакты прогонов тестов и сборки: результат прогона, а не контракт репозитория.
TestResults/
*.binlog
